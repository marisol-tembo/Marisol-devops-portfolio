# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform CLI plan files
*.tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# macOS files
.DS_Store